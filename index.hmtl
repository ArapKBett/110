      <circle cx="230" cy="100" r="70" fill="rgba(37,99,235,.45)" clip-path="url(#clipAB)"/>
      <text class="name" x="70" y="40">A</text>
      <text class="name" x="280" y="40">B</text>
    </svg>

    <p><strong>(ii) \(A\cup B\)</strong> — everything inside either circle.</p>
    <svg class="venn" viewBox="0 0 360 200" role="img" aria-label="A union B">
      <circle cx="130" cy="100" r="70" fill="rgba(37,99,235,.35)" stroke="#2563eb"/>
      <circle cx="230" cy="100" r="70" fill="rgba(37,99,235,.35)" stroke="#10b981"/>
      <text class="name" x="70" y="40">A</text>
      <text class="name" x="280" y="40">B</text>
    </svg>

    <p><strong>(iii) \(A\triangle B\)</strong> — symmetric difference: in exactly one of the two sets.</p>
    <svg class="venn" viewBox="0 0 360 200" role="img" aria-label="A symmetric difference B">
      <circle cx="130" cy="100" r="70" fill="rgba(37,99,235,.4)" stroke="#2563eb"/>
      <circle cx="230" cy="100" r="70" fill="rgba(37,99,235,.4)" stroke="#10b981"/>
